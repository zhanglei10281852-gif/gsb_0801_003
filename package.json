{
  "name": "edge-dispatch",
  "version": "1.0.0",
  "private": true,
  "description": "Reliable device-command dispatch service for frequently-disconnected edge gateways",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/main.js",
  "bin": {
    "edge-dispatch": "dist/main.js",
    "edge-sim": "dist/sim/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "sim": "node dist/sim/cli.js",
    "test": "node --import tsx --test test/domain.test.ts test/ownership.test.ts test/service.test.ts test/http.test.ts",
    "e2e": "npm run build && node dist/e2e/acceptance.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
